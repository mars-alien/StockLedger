# Copy this file to server/.env for development, and to server/.env.test for the
# test run. config/env.js picks the file based on NODE_ENV and refuses to start
# if anything below is missing or malformed.

NODE_ENV=development
PORT=5000

# Local Postgres for development. DIRECT_URL is only different on Supabase,
# where DATABASE_URL points at the pooler (port 6543) and migrations have to
# use the direct connection (port 5432).
#
# Prisma sizes its pool at (cpus * 2 + 1), which is 3 on a one-core host. Orders
# queue on a row lock by design, so a small pool turns a busy moment into
# timeouts. Append &connection_limit=10 on a shared-CPU deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockledger?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/stockledger?schema=public

# Supabase, for reference:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins. "*" is rejected.
CORS_ORIGINS=http://localhost:5173

# Where invitation links point.
APP_URL=http://localhost:5173


# Leave these empty to run without image uploads: the endpoint answers 503 and
# the rest of the catalog is unaffected.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test mode. Leave empty to run without payments: the payment endpoints
# answer 503 and invoices still download. The webhook secret is the one you set
# when creating the webhook in the Razorpay dashboard, not the API secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

LOG_LEVEL=debug

# How many proxies sit in front of this server, counted from the right. Never
# "true": that trusts the leftmost X-Forwarded-For entry, which the client
# controls, and the per-IP login limit becomes trivial to bypass.
#   0  local
#   1  behind Render or Fly alone
#   2  behind Vercel rewriting /api to Render
TRUST_PROXY=0

DEMO_ENDPOINTS_ENABLED=true

# Leave true everywhere except a load test, which measures the limiter otherwise.
RATE_LIMIT_ENABLED=true
